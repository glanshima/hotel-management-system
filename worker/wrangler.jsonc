{
	"name": "hotel-management-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-08",
	"observability": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hotel-management-db",
			// database_id is populated after running: wrangler d1 create hotel-management-db
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations",
		},
	],
}
